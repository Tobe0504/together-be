# Copy to .env. scripts/dev-up.sh manages LAN_IP; the rest are yours.
# .env is gitignored — never commit real credentials.

# This machine's LAN IP, used by docker-compose and livekit.yaml.
LAN_IP=192.168.1.100

# --- Database -------------------------------------------------------------
# Local development uses a SQLite file (server/together.db) and needs
# nothing here. Set DATABASE_URL to run against Turso instead — required in
# production, where hosts like Render have ephemeral disks that would wipe a
# local file on every restart.
#   libsql://<db>-<org>.turso.io?authToken=<token>
# DATABASE_URL=

# --- Secrets --------------------------------------------------------------
# Signs room and account session tokens. Generate: openssl rand -base64 48
# The built-in default is fine locally and unsafe anywhere else.
# JWT_SECRET=

# LiveKit Cloud (https://cloud.livekit.io). Leave unset to use the
# self-hosted livekit container from docker-compose.yml, which only works
# for viewers that can reach this machine directly.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- CORS -----------------------------------------------------------------
# Comma-separated origins allowed to call the API. localhost and private
# LAN origins are always allowed; this is for deployed frontends.
# CORS_ORIGIN=https://together-fe.vercel.app
