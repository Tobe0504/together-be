# GitHub's standard Go template, plus this project's own entries.

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# --- Together ---------------------------------------------------------

# Build output
together-server
bin/
tmp/

# SQLite database + its write-ahead log sidecars — runtime data, never committed
*.db
*.db-journal
*.db-wal
*.db-shm

# Secrets. .env holds LIVEKIT_API_SECRET and JWT_SECRET; .env.example is the
# committed template and is deliberately kept.
.env
.env.*
!.env.example

.DS_Store
